<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>OpenCodeList CLI</Product>
    <Description>A CLI for working with OpenCodeList file format</Description>
    <Authors>STÜBER SYSTEMS GmbH</Authors>
    <Company>STÜBER SYSTEMS GmbH</Company>
    <Copyright>© 2026 STÜBER SYSTEMS GmbH</Copyright>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ocl</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Enbrea.Csv" Version="0.14.0" />
    <PackageReference Include="Enbrea.Konsoli" Version="0.2.0" />
    <PackageReference Include="OpenCodeList.Net" Version="0.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Link="README.md" />
    <None Include="..\LICENSE" Link="LICENSE" />
  </ItemGroup>

</Project>
